# ---------------------------------------------------------------------------
# 环境变量样例。复制成 .env 后按机器填写；.env 已被 gitignore，不会进版本库。
#
# 这个文件只描述"有哪些变量、干什么用"，不写任何真实用户路径，也不写凭据。
# 认证由 CLI 自己管（claude login / codex login）—— 框架不读、不存、不打印
# 任何 token；把 token 写进这里没有任何作用，只会造成泄漏面。
# ---------------------------------------------------------------------------

# --- CLI 可执行文件（全部可选）---------------------------------------------
# 不设也行：框架会用 PATH + 平台已知安装位置自动发现（`python main.py doctor`
# 会告诉你实际用的是哪个路径）。设了则以你设的为准。
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=

# --- 语义记忆（可选，不装就是词法检索，Runtime 照常工作）------------------
# worker_interpreter: 装了 torch + sentence-transformers 的**独立** venv 解释器
# model_path:         模型 repo id 或本地目录（不要把绝对路径写进公共配置）
# hf_home:            HuggingFace 缓存目录
MEMORY_EMBEDDING_INTERPRETER=
MEMORY_EMBEDDING_MODEL_PATH=BAAI/bge-m3
MEMORY_HF_HOME=

# --- 模型下载源 ------------------------------------------------------------
# huggingface.co 在部分网络不可达；镜像 + 关闭 XET 是已验证可用的组合。
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# --- 测试计数工具用的解释器（可选）----------------------------------------
# 不设时 tools/baseline_count.py 用运行它的那个 python。
MAO_PY_EXE=
